# App
NEXT_PUBLIC_APP_URL=http://localhost:9003

# PostgreSQL (newsletter, contact, legacy orders)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Stripe (LEGACY — solo si aún usas /api/stripe/webhook + pedidos Prisma)
# El checkout de la tienda ya va por WooCommerce Store API.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# WooCommerce REST API + Store API (obligatorio en Vercel Production)
# WP Admin → WooCommerce → Settings → Advanced → REST API → Add key
# Permissions: Read (catálogo) — Read/Write si hace falta admin
WC_BASE_URL=https://bouletmushrooms.com
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx
# Gateway activo en WP (Boulet usa Square)
WC_PAYMENT_METHOD=square_credit_card

# Square Web Payments embebido en Next (opcional)
# Sin estas vars: pedido pendiente + puente → WP order-pay
# Con ellas: formulario de tarjeta en /checkout (puede cobrar en production)
# WP → WooCommerce → Square, o Square Dashboard → Applications / Locations
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=sq0idp-xxxxxxxx
# NEXT_PUBLIC_SQUARE_LOCATION_ID=LXXXXXXXX
